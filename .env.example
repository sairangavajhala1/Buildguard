# Smallest.ai TTS credentials and tuning
SMALLEST_AI_API_KEY=your_key_here
SMALLEST_AI_VOICE_ID=emily
SMALLEST_AI_TTS_URL=https://waves-api.smallest.ai/api/v1/lightning/get_speech

# Where generated alert audio is written (project-relative)
BUILDGUARD_AUDIO_DIR=output/audio

# Optional: webhook that receives the generated audio to place the actual
# phone call (e.g. Twilio/SIP gateway). Leave empty to generate audio only.
BUILDGUARD_CALL_WEBHOOK_URL=